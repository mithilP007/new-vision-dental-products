# ==============================================================================
# NEW VISION DENTAL PRODUCTS — SUPABASE & NEXT.JS ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# INSTRUCTIONS TO RETRIEVE YOUR SUPABASE CREDENTIALS:
# 1. Open your Supabase Dashboard: https://supabase.com/dashboard/project/tcrkavwcbklvnbzorjnz
# 2. Go to Project Settings -> API.
# 3. Copy:
#    - Project URL: https://<project-ref>.supabase.co
#    - Publishable / Anon Public Key: sb_publishable_... or eyJ...
#    - Service Role Secret Key (Optional for backend administrative scripts only)
# 4. Under Storage -> Buckets:
#    - Create a Public Bucket named "product-images"
# ==============================================================================

# Supabase Client SDK Configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-side Service Role Key (Keep secret, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
